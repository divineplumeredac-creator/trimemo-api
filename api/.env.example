# --- OpenAI ---
OPENAI_API_KEY=
# Nom EXACT d'un modèle disponible sur votre compte OpenAI (vérifiez-le dans le tableau de bord).
OPENAI_MODEL=

# --- Espace propriétaire (/owner) ---
TRIMEMO_OWNER_EMAIL=
TRIMEMO_OWNER_PASSWORD=
# OBLIGATOIRE : chaîne aléatoire d'au moins 32 caractères, différente du mot de passe
# (générer avec : openssl rand -base64 48)
TRIMEMO_OWNER_AUTH_SECRET=
# Optionnel : secret distinct pour les jetons premium (sinon TRIMEMO_OWNER_AUTH_SECRET est utilisé)
TRIMEMO_PREMIUM_AUTH_SECRET=

# --- PayPal ---
PAYPAL_ENV=sandbox   # passer à "live" uniquement après les tests
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- URL du frontend (retour PayPal) ---
TRIMEMO_FRONTEND_URL=https://trimemo-frontend.vercel.app

# --- Rate limiting partagé (recommandé en production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
