# --- OpenAI ---
OPENAI_API_KEY=
# Nom EXACT d'un modèle disponible sur votre compte OpenAI (vérifiez-le dans le tableau de bord).
OPENAI_MODEL=

# --- Espace propriétaire (/owner) ---
TRIMEMO_OWNER_EMAIL=
TRIMEMO_OWNER_PASSWORD=
# En production, utiliser le hash scrypt plutôt que le mot de passe en clair : scrypt$<sel>$<hex>
TRIMEMO_OWNER_PASSWORD_HASH=
# OBLIGATOIRE : chaîne aléatoire d'au moins 32 caractères, différente du mot de passe
# (générer avec : openssl rand -base64 48)
TRIMEMO_OWNER_AUTH_SECRET=
# Secret distinct obligatoire pour signer les jetons premium
TRIMEMO_PREMIUM_AUTH_SECRET=
# Secret distinct et obligatoire pour signer les devis (openssl rand -base64 48)
TRIMEMO_PRICING_SECRET=

# --- PayPal ---
PAYPAL_ENV=sandbox   # passer à "live" uniquement après les tests
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- URL du frontend (retour PayPal) ---
TRIMEMO_FRONTEND_URL=https://trimemo-frontend.vercel.app
# Origines supplémentaires exactes, séparées par des virgules (aucune regex wildcard)
TRIMEMO_ALLOWED_ORIGINS=

# --- Rate limiting partagé (obligatoire en production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Registre serveur obligatoire pour les paiements premium et les crédits à usage unique
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
